{
  "name": "better-auth-identifier",
  "version": "0.1.0",
  "description": "Better Auth plugin that signs users in with either their email or their username in a single field.",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "username",
    "email",
    "login",
    "sign-in",
    "identifier",
    "auth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weesofficial/better-auth-identifier.git"
  },
  "homepage": "https://github.com/Weesofficial/better-auth-identifier#readme",
  "bugs": {
    "url": "https://github.com/Weesofficial/better-auth-identifier/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "better-auth": "^1.7.13",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
